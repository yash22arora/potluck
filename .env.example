# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing in this project reads a secret from
# anywhere else — that is what makes "one container per household" possible.
# ---------------------------------------------------------------------------

ENV=local
LOG_LEVEL=INFO

# --- safety -----------------------------------------------------------------
# DRY_RUN=true means no Swiggy call that costs money is ever executed.
# Leave it true until phase 7.
DRY_RUN=true
DAILY_BUDGET_INR=1500

# --- security ---------------------------------------------------------------
# Encrypts Swiggy tokens at rest. `make env` generates one for you; if you set
# it by hand:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates stored tokens — you would need to re-authorize.
SECRET_KEY=

# --- database ---------------------------------------------------------------
# Matches compose.yml. On Railway, paste the provided connection string and
# change the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://potluck:potluck@localhost:5432/potluck

# --- models -----------------------------------------------------------------
# Format is "provider:model". Two roles, deliberately: the planner does the
# reasoning, the gate is the cheap classifier that reads every message.
PLANNER_MODEL=anthropic:claude-sonnet-4-5
GATE_MODEL=openai:gpt-4o-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- telegram (phase 1) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of this deployment, used to register the webhook.
PUBLIC_BASE_URL=

# --- swiggy mcp -------------------------------------------------------------
# The surface URLs are fixed and derived from this base:
#   food      {base}/food
#   instamart {base}/im        <- note /im, not /instamart
#   dineout   {base}/dineout
SWIGGY_BASE_URL=https://mcp.swiggy.com
SWIGGY_SCOPES=mcp:tools mcp:resources mcp:prompts

# Must match a registered redirect exactly. http://localhost is the one
# non-HTTPS exception Swiggy allows, and it is whitelisted for development.
# On Railway, set this to https://<your-app>.up.railway.app/auth/swiggy/callback
SWIGGY_REDIRECT_URI=http://localhost:8000/auth/swiggy/callback

# There is no client id or secret to paste here. Swiggy uses dynamic client
# registration (RFC 7591) — Potluck registers itself on first use and stores
# the issued client_id in the database.
