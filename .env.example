# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing in this project reads a secret from
# anywhere else — that is what makes "one container per household" possible.
# ---------------------------------------------------------------------------

ENV=local
LOG_LEVEL=INFO

# --- safety -----------------------------------------------------------------
# DRY_RUN=true means no Swiggy call that costs money is ever executed.
# Leave it true until phase 7.
DRY_RUN=true
DAILY_BUDGET_INR=1500

# --- database ---------------------------------------------------------------
# Matches compose.yml. On Railway, paste the provided connection string and
# change the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://potluck:potluck@localhost:5432/potluck

# --- models -----------------------------------------------------------------
# Format is "provider:model". Two roles, deliberately: the planner does the
# reasoning, the gate is the cheap classifier that reads every message.
PLANNER_MODEL=anthropic:claude-sonnet-4-5
GATE_MODEL=openai:gpt-4o-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- telegram (phase 1) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of this deployment, used to register the webhook.
PUBLIC_BASE_URL=

# --- swiggy mcp (phase 2) ---------------------------------------------------
# Fill these from the Swiggy builders console once you have credentials.
SWIGGY_FOOD_MCP_URL=
SWIGGY_INSTAMART_MCP_URL=
SWIGGY_DINEOUT_MCP_URL=
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
